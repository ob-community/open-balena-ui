PORT=3000
NODE_ENV=development

# Authenticated S3-compatible endpoint (SeaweedFS S3 gateway, MinIO, or AWS S3), using path-style requests.
OPEN_BALENA_S3_URL=https://s3.my-open-balena-server.com
OPEN_BALENA_S3_ACCESS_KEY=
OPEN_BALENA_S3_SECRET_KEY=
OPEN_BALENA_S3_REGISTRY_BUCKET=registry-data
OPEN_BALENA_S3_REGION=us-east-1

# Private, pre-provisioned bucket for local device-type.json objects (API v46.1+ Host OS sync).
OPEN_BALENA_OS_METADATA_BUCKET=balena-os-metadata

# Stable UI origin reachable from ob-api (may be internal); not sent to devices during normal provisioning/target state.
# Defaults to REACT_APP_OPEN_BALENA_UI_URL.
OPEN_BALENA_OS_METADATA_URL=

# Public metadata source used only during manual sync.
OPEN_BALENA_OS_METADATA_SOURCE_URL=https://resin-production-img-cloudformation.s3.amazonaws.com/images

# Mirror ob-api's semicolon-separated CONTRACT_ALLOWLIST. Empty means all local device types.
CONTRACT_ALLOWLIST=

# Server-side secret used to verify openBalena bearer JWTs.
OPEN_BALENA_JWT_SECRET=

# Optional positive numeric user.id used for one-time global-admin bootstrap at server startup.
# WARNING: without this setting or an existing global-admin role, every authenticated user retains legacy super-admin access.
OPEN_BALENA_BOOTSTRAP_USER_ID=

# Optional comma-separated role names organization-admin users may assign within their organization scope
OPEN_BALENA_ORGANIZATION_ADMIN_ASSIGNABLE_ROLES=

# Internal server-only endpoint; also required for stored Host OS WebResource references on API v46.1+.
# Never point this at a browser-facing /postgrest proxy.
OPEN_BALENA_POSTGREST_URL=https://postgrest.my-open-balena-server.com

# Browser-facing API and UI endpoints.
REACT_APP_OPEN_BALENA_API_URL=https://api.my-open-balena-server.com
REACT_APP_OPEN_BALENA_UI_URL=https://admin.my-open-balena-server.com

# API and optional OData versions.
REACT_APP_OPEN_BALENA_API_VERSION=v14.13.3
REACT_APP_OPEN_BALENA_ODATA_VERSION=

# Optional custom banner image.
REACT_APP_BANNER_IMAGE=

# Remote access mode: a non-empty URL selects legacy open-balena-remote.
# Leave empty to select built-in SSH/SFTP; configure OPEN_BALENA_TUNNEL_URL below.
REACT_APP_OPEN_BALENA_REMOTE_URL=https://remote.my-open-balena-server.com

# Built-in SSH/SFTP transport (server-only); also requires the API URL, PostgREST URL, and JWT secret above.
# Stock internal CONNECT endpoint example: http://ob-vpn.openbalena.svc.cluster.local:3128
# Plain HTTP must stay on trusted internal/encrypted networking; use HTTPS for a TLS-enabled CONNECT endpoint.
# The VPN listener on port 443 requires PROXY protocol and is not the CONNECT endpoint.
# Leave the tunnel URL empty to keep the built-in gateway unconfigured.
OPEN_BALENA_TUNNEL_URL=
OPEN_BALENA_SSH_TARGET_PORT=22222
OPEN_BALENA_REMOTE_CONNECT_TIMEOUT_MS=15000

# Reuse one ephemeral SSH key per active user; delete after the last terminal/transfer closes plus this idle delay.
# Default: 600000 milliseconds (10 minutes).
OPEN_BALENA_SSH_KEY_IDLE_TTL_MS=600000

# SSH host-key verification: comma-separated <uuid>=SHA256:<fingerprint> pins.
# A standalone SHA256:<fingerprint> entry applies to all devices. Configure pins before using strict mode.
OPEN_BALENA_SSH_HOST_KEYS=

# Legacy compatibility only: allow unpinned host keys. Explicit pins still reject mismatches.
# Keep false for strict host-key verification.
OPEN_BALENA_SSH_ALLOW_UNVERIFIED_HOST_KEYS=false

# Public browser origin when TLS terminates at a reverse proxy, e.g. https://admin.my-open-balena-server.com.
# Without it, same-origin checks use the direct socket scheme and Host header, not forwarded headers.
OPEN_BALENA_REMOTE_PUBLIC_ORIGIN=

# Optional comma-separated trusted proxy IPs/CIDRs, e.g. 10.0.0.10/32,10.0.0.11/32.
# Empty trusts none. HTTP and WebSocket client addresses use only trusted X-Forwarded-For hops.
# Configure only ingress/proxy addresses, never every client address; blanket /0 policies are rejected.
OPEN_BALENA_REMOTE_TRUSTED_PROXIES=

# Optional comma-separated additional browser origins; scheme, hostname, and effective port must match.
OPEN_BALENA_REMOTE_ALLOWED_ORIGINS=

# Single-use WebSocket authentication ticket lifetime in milliseconds (default: 30 seconds).
OPEN_BALENA_REMOTE_TICKET_TTL_MS=30000

# Pending, unconsumed WebSocket tickets per user and per server process; excess issuance returns HTTP 429.
OPEN_BALENA_REMOTE_MAX_PENDING_TICKETS_PER_USER=8
OPEN_BALENA_REMOTE_MAX_PENDING_TICKETS=1024

# Concurrent terminal/SFTP operations per user, pre-authentication WebSockets per resolved client IP,
# and logical terminals per WebSocket. Shared client NATs may need a higher per-IP WebSocket limit.
OPEN_BALENA_REMOTE_MAX_OPERATIONS_PER_USER=8
OPEN_BALENA_REMOTE_MAX_WEBSOCKETS_PER_IP=8
OPEN_BALENA_REMOTE_MAX_CHANNELS_PER_SOCKET=4

# Maximum WebSocket message size in bytes (default: 1 MiB).
OPEN_BALENA_REMOTE_MAX_MESSAGE_BYTES=1048576

# SFTP upload size and device-path UTF-8 length limits in bytes (default: 1 GiB and 4096 bytes).
OPEN_BALENA_REMOTE_MAX_UPLOAD_BYTES=1073741824
OPEN_BALENA_REMOTE_MAX_PATH_BYTES=4096
