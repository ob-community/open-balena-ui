PORT=3000
NODE_ENV=development

# Authenticated S3-compatible endpoint (SeaweedFS S3 gateway, MinIO, or AWS S3), using path-style requests.
OPEN_BALENA_S3_URL=https://s3.my-open-balena-server.com
OPEN_BALENA_S3_ACCESS_KEY=
OPEN_BALENA_S3_SECRET_KEY=
OPEN_BALENA_S3_REGISTRY_BUCKET=registry-data
OPEN_BALENA_S3_REGION=us-east-1
# Private, pre-provisioned bucket for local device-type.json objects (API v46.1+ Host OS sync).
OPEN_BALENA_OS_METADATA_BUCKET=balena-os-metadata
# Stable UI origin reachable from ob-api (may be internal); not sent to devices during normal provisioning/target state.
# Defaults to REACT_APP_OPEN_BALENA_UI_URL.
OPEN_BALENA_OS_METADATA_URL=
# Public metadata source used only during manual sync.
OPEN_BALENA_OS_METADATA_SOURCE_URL=https://resin-production-img-cloudformation.s3.amazonaws.com/images
# Mirror ob-api's semicolon-separated CONTRACT_ALLOWLIST. Empty means all local device types.
CONTRACT_ALLOWLIST=
OPEN_BALENA_JWT_SECRET=
# Optional positive numeric user.id used for one-time global-admin bootstrap at server startup.
# WARNING: without this setting or an existing global-admin role, every authenticated user retains legacy super-admin access.
OPEN_BALENA_BOOTSTRAP_USER_ID=
# Optional comma-separated role names organization-admin users may assign within their organization scope
OPEN_BALENA_ORGANIZATION_ADMIN_ASSIGNABLE_ROLES=

# Internal server-only endpoint; also required for stored Host OS WebResource references on API v46.1+.
# Never point this at a browser-facing /postgrest proxy.
OPEN_BALENA_POSTGREST_URL=https://postgrest.my-open-balena-server.com
REACT_APP_OPEN_BALENA_REMOTE_URL=https://remote.my-open-balena-server.com
REACT_APP_OPEN_BALENA_API_URL=https://api.my-open-balena-server.com
REACT_APP_OPEN_BALENA_UI_URL=https://admin.my-open-balena-server.com
REACT_APP_OPEN_BALENA_API_VERSION=v14.13.3
REACT_APP_OPEN_BALENA_ODATA_VERSION=
REACT_APP_BANNER_IMAGE=
