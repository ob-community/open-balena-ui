{
  "name": "open-balena-ui",
  "version": "0.9.0",
  "private": true,
  "engines": {
    "node": ">=24"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.913.0",
    "@emotion/react": "^11.14.0",
    "@emotion/styled": "^11.14.1",
    "@mui/icons-material": "^6.5.0",
    "@mui/material": "^6.5.0",
    "@tanstack/react-query": "^5.104.1",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/xterm": "^6.0.0",
    "assert": "^2.1.0",
    "axios": "^1.12.2",
    "base32-encode": "^2.0.0",
    "bcrypt-ts": "^7.1.0",
    "buffer": "^6.0.3",
    "classnames": "^2.5.1",
    "core-js": "^3.46.0",
    "dateformat": "^5.0.3",
    "decode-uri-component": "file:vendor/decode-uri-component",
    "dotenv": "^17.2.3",
    "express": "^5.1.0",
    "express-rate-limit": "^8.1.0",
    "express-slow-down": "^3.0.0",
    "final-form": "^5.0.0",
    "jose": "^6.1.0",
    "jwt-decode": "^4.0.0",
    "micro-key-producer": "^0.8.2",
    "process": "^0.11.10",
    "prop-types": "^15.8.1",
    "proxy-addr": "^2.0.7",
    "query-string": "^7.1.3",
    "ra-core": "5.15.3",
    "react": "^19.2.3",
    "react-admin": "5.15.3",
    "react-dom": "^19.2.3",
    "react-final-form": "^7.0.0",
    "react-hook-form": "^7.65.0",
    "react-password-checklist": "^1.8.1",
    "react-router": "^7.9.5",
    "react-router-dom": "^7.9.5",
    "regenerator-runtime": "^0.14.1",
    "semver": "^7.7.3",
    "serialize-javascript": "^7.1.2",
    "ssh2": "^1.17.0",
    "uuid": "^13.0.0",
    "ws": "^8.22.0"
  },
  "devDependencies": {
    "@types/dateformat": "^5.0.3",
    "@types/dotenv": "^6.1.1",
    "@types/express": "^4.17.23",
    "@types/express-rate-limit": "^5.1.3",
    "@types/express-slow-down": "^1.3.5",
    "@types/node": "^24.10.0",
    "@types/proxy-addr": "^2.0.3",
    "@types/query-string": "^6.2.0",
    "@types/react": "^19.2.2",
    "@types/react-dom": "^19.2.2",
    "@types/ssh2": "^1.15.6",
    "@types/ws": "^8.18.1",
    "@vercel/ncc": "^0.38.3",
    "@vitejs/plugin-react-swc": "^4.2.1",
    "concurrently": "^10.0.5",
    "prettier": "^3.6.2",
    "tsx": "^4.19.2",
    "typescript": "^5.9.3",
    "vite": "^7.2.2"
  },
  "scripts": {
    "start": "npm run build && npm run serve",
    "serve": "node dist/server/index.js",
    "serve:dev": "tsx --env-file=.env server/dev.ts",
    "dev": "concurrently --kill-others --names client,server \"vite --mode devprod --host 0.0.0.0\" \"npm run serve:dev\"",
    "dev:local": "vite --mode local",
    "build": "npm run build:client && npm run build:server",
    "build:client": "vite build",
    "build:server": "ncc build server/index.ts -o dist/server -m",
    "preview": "vite preview --outDir dist/client",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test src/authProvider/*.test.ts src/components/*.test.ts src/dataProvider/*.test.ts src/lib/*.test.ts src/versions/*.test.ts server/*.test.ts server/remoteAccess/*.test.ts test/*.test.ts",
    "prettier": "prettier --write ."
  },
  "browserslist": {
    "production": [
      ">0.2%",
      "not dead",
      "not op_mini all"
    ],
    "development": [
      "last 1 chrome version",
      "last 1 firefox version",
      "last 1 safari version"
    ]
  },
  "overrides": {
    "query-string": {
      "decode-uri-component": "$decode-uri-component"
    }
  }
}
